# --- YTM Desktop companion server -----------------------------------------

# IP/host where YTM Desktop's companion server is running.
# Use 127.0.0.1 if this app runs on the same machine as YTM Desktop.
REMOTE_IP=127.0.0.1

# Port of the companion server (default in YTM Desktop settings is 9863).
REMOTE_PORT=9863

# Companion API version to request. Must be one of the versions returned by
# GET /metadata on the companion server (checked at startup).
API_VERSION=v1

# --- App identity (shown to the user when approving the pairing code) ------

APP_ID=ytm-desktop-webapp
APP_NAME=YTM-Desktop WebApp
APP_VERSION=1.0.0

# --- This app's own web server ----------------------------------------------

# Port this Bun process listens on, for the web UI + WebSocket endpoint.
# Optional — defaults to 8080 if unset.
SERVER_PORT=8080

# Path to the file used to persist the companion server auth token between
# runs, so you don't have to re-approve a pairing code every restart.
# Optional — defaults to "token.txt" if unset.
TOKEN_FILE_PATH=token.txt
